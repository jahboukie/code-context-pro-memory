rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY: Helper functions for enhanced validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(email) {
      return isAuthenticated() && request.auth.token.email == email;
    }
    
    function isValidLicenseRead() {
      return isAuthenticated() && 
             (request.auth.token.email == resource.data.email ||
              request.auth.uid == resource.data.firebaseUid);
    }
    
    function isValidEmail(email) {
      return email != null && 
             email is string && 
             email.matches('.*@.*\\..*');
    }

    // License collection - enhanced security with multiple validation layers
    match /licenses/{licenseId} {
      // Read: Only license owner can read their license
      allow read: if isValidLicenseRead();
      
      // Write: Extremely restricted - only specific updates allowed
      allow update: if isAuthenticated() && 
                       request.auth.token.email == resource.data.email &&
                       // Only allow updates to specific fields
                       request.writeFields.hasOnly(['lastUsed', 'usage']) &&
                       // Prevent privilege escalation
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.tier == resource.data.tier &&
                       request.resource.data.active == resource.data.active;
      
      // Create/Delete: Prohibited for clients (only Cloud Functions)
      allow create, delete: if false;
    }
    
    // Public stats - read-only for clients
    match /public/{document} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions via Admin SDK
    }
    
    // Usage analytics - enhanced validation
    match /usage/{usageId} {
      allow read: if isAuthenticated() && 
                     request.auth.token.email == resource.data.email;
      
      allow create: if isAuthenticated() && 
                       isValidEmail(request.resource.data.email) &&
                       request.auth.token.email == request.resource.data.email &&
                       // Validate required fields
                       request.resource.data.keys().hasAll(['licenseKey', 'action', 'timestamp', 'email']);
      
      // No updates or deletes allowed for usage logs (audit trail)
      allow update, delete: if false;
    }
    
    // Memory data collection - user-specific with encryption validation  
    match /memory/{userId}/projects/{projectId} {
      allow read, write: if isAuthenticated() && 
                            request.auth.uid == userId &&
                            // Ensure data is encrypted (has required encryption fields)
                            (resource == null || resource.data.encrypted == true);
    }
    
    // Payments collection - completely server-side only
    match /payments/{paymentId} {
      allow read, write: if false; // Only Cloud Functions via Admin SDK
    }
    
    // Admin collections - completely prohibited
    match /admin/{document=**} {
      allow read, write: if false; // Only Admin SDK access
    }
    
    // Backup/audit collections - read-only for authenticated users
    match /audit/{auditId} {
      allow read: if isAuthenticated() && 
                     request.auth.token.email == resource.data.userEmail;
      allow write: if false; // Only Cloud Functions
    }
    
    // Default deny rule for any unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}